# ==============================================================================
# Configuración de entorno (leída por src/set-env.js → genera environment.ts)
# Ejecuta: npm run config   (o npm start / npm run build que lo regeneran solos)
# ==============================================================================

# ------------------------------------------------------------------------------
# PROVEEDOR ACTIVO
# Nombre de un proveedor definido abajo (clave <NOMBRE>_API_URL).
# Cambia esta línea para apuntar a otro proveedor sin tocar más nada.
# Ejemplos: render | tunnel | local
# ------------------------------------------------------------------------------
API_PROVIDER=render

# ------------------------------------------------------------------------------
# URL DIRECTA (override)
# Si la defines, tiene prioridad absoluta sobre API_PROVIDER.
# Útil para CI/CD, despliegues o un cambio puntual de proveedor.
# ------------------------------------------------------------------------------
#API_URL=https://backend-junta-agua-hn.onrender.com/api

# ------------------------------------------------------------------------------
# PROVEEDORES DISPONIBLES
# Agrega tantos como quieras con el patrón <NOMBRE>_API_URL.
# ------------------------------------------------------------------------------
RENDER_API_URL=https://backend-junta-agua-hn.onrender.com/api
TUNNEL_API_URL=https://4r430trl-4000.use2.devtunnels.ms/api
LOCAL_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# Otras configuraciones
# ------------------------------------------------------------------------------
NODE_ENV=false
CURRENCY_SYMBOL="L "
